# =============================================================
# WhatsApp Agent on Contabo/Dokploy — environment (Dokploy -> Environment tab)
# Compose file: docker-compose.contabo.yml
# Every secret below must be generated fresh; none is copied from another system.
# =============================================================

# DeepInfra (chat, embeddings, speech-to-text, vision, image edit/generate)
DEEPINFRA_API_KEY=

# Evolution API (WhatsApp protocol layer) — openssl rand -hex 32
EVOLUTION_API_KEY=
INSTANCE_NAME=ai-tools-wa

# Postgres / Redis (internal only)
POSTGRES_DB=evolution
POSTGRES_USER=wa
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Bridge admin panel (HTTP Basic Auth) at https://wa.loopstech.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Evolution -> bridge webhook shared secret — openssl rand -hex 32
WEBHOOK_SECRET=

# Phone numbers (digits only, comma separated) allowed as admins on first message.
# Others are registered as "not allowed" until approved in the admin panel.
INITIAL_ALLOWED_NUMBERS=

# Gateway <-> AI Tools hub
GATEWAY_API_KEY=
CORTEX_SERVICE_USERNAME=wa-gateway
CORTEX_SERVICE_PASSWORD=
CORTEX_HUB_BASE_URL=https://ai-tool.loopstech.com

# Optional model overrides (defaults shown)
# AI_MODEL=openai/gpt-oss-120b
# AI_EMBEDDING_MODEL=BAAI/bge-m3
# STT_MODEL=openai/whisper-large-v3-turbo
# IMAGE_EDIT_MODEL=black-forest-labs/FLUX.1-Kontext-dev
# IMAGE_GEN_MODEL=black-forest-labs/FLUX-1-schnell
# VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
# TTS_VOICE_EN=en-US-JennyNeural
# TTS_VOICE_AR=ar-SA-HamedNeural
