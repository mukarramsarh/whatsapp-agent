# =============================================================
# WhatsApp Agent — Environment Variables
# Copy this to .env and fill in your values
# =============================================================

# -------------------------------------------------------------
# EVOLUTION API — Authentication
# Generate a strong random string (e.g. openssl rand -hex 32)
# -------------------------------------------------------------
EVOLUTION_API_KEY=changeme-super-secret-api-key-32chars

# -------------------------------------------------------------
# EVOLUTION API — Public URL
# Set to your server's public URL (used by Evolution API for
# self-referencing in webhooks and QR code callbacks)
# Example for Dokploy: https://evolution.yourdomain.com
# For local dev: http://localhost:5020
# -------------------------------------------------------------
EVOLUTION_SERVER_URL=http://localhost:5020

# -------------------------------------------------------------
# POSTGRESQL
# -------------------------------------------------------------
POSTGRES_DB=evolution
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-strong-db-password

# -------------------------------------------------------------
# REDIS
# -------------------------------------------------------------
REDIS_PASSWORD=changeme-strong-redis-password

# -------------------------------------------------------------
# BRIDGE (Python layer)
# -------------------------------------------------------------
# The WhatsApp instance name (created via Evolution API)
INSTANCE_NAME=whatsapp-agent

# The URL the Evolution API will call for incoming messages.
# Must be reachable FROM the evolution-api container.
# Inside Docker (same compose): http://bridge:5021/webhook
# If Evolution API is external: https://yourserver.com:5021/webhook
WEBHOOK_URL=http://bridge:5021/webhook
