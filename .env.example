# =============================================================
# WhatsApp Agent — Environment Variables
# Copy this to .env and fill in your values
# =============================================================

# -------------------------------------------------------------
# EVOLUTION API — Authentication
# Generate a strong random string (e.g. openssl rand -hex 32)
# -------------------------------------------------------------
EVOLUTION_API_KEY=changeme-sarh-secret-ph-key-32chars

# -------------------------------------------------------------
# EVOLUTION API — Public URL
# Set to your server's public URL (used by Evolution API for
# self-referencing in webhooks and QR code callbacks)
# Example for Dokploy: https://evolution.yourdomain.com
# For local dev: http://localhost:5020
# -------------------------------------------------------------
EVOLUTION_SERVER_URL=http://localhost:5020

# -------------------------------------------------------------
# POSTGRESQL
# -------------------------------------------------------------
POSTGRES_DB=evolution
POSTGRES_USER=procurementhub
POSTGRES_PASSWORD=changeme-strong-db-password

# -------------------------------------------------------------
# REDIS
# -------------------------------------------------------------
REDIS_PASSWORD=changeme-strong-redis-password

# -------------------------------------------------------------
# BRIDGE (Python layer)
# -------------------------------------------------------------
# The WhatsApp instance name (created via Evolution API)
INSTANCE_NAME=STC

# The URL the Evolution API will call for incoming messages.
# Must be reachable FROM the evolution-api container.
# Inside Docker (same compose): http://bridge:5021/webhook
# If Evolution API is external: https://yourserver.com:5021/webhook
WEBHOOK_URL=http://bridge:5021/webhook

# -------------------------------------------------------------
# PGADMIN (PostgreSQL UI — available at port 5022)
# -------------------------------------------------------------
PGADMIN_EMAIL=it@procurementhub.sa
PGADMIN_PASSWORD=changeme-pgadmin-password

# -------------------------------------------------------------
# ADMIN PANEL (Bridge UI — available at port 5021/admin)
# HTTP Basic Auth credentials to protect the admin panel
# -------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme-admin-password

# -------------------------------------------------------------
# PH OCR API (document/image text extraction — port 5010)
# -------------------------------------------------------------
OCR_API_URL=http://192.168.100.62:5010
OCR_API_KEY=your-shared-secret-key

# -------------------------------------------------------------
# AI AGENT (Phase 2) — DGX Spark model stack
# The bridge runs inside Docker, so it cannot use the DGX's
# "localhost:800x" — reach the host via its LAN IP (proven routable,
# same box as the OCR API) or via host.docker.internal (mapped in
# docker-compose extra_hosts). NOTE: the DGX inference servers must
# bind to 0.0.0.0, not 127.0.0.1, or the container can't connect.
#   vLLM:   --host 0.0.0.0        Ollama: OLLAMA_HOST=0.0.0.0:11434
# -------------------------------------------------------------
# Chat LLM — gpt-oss 20b (OpenAI-compatible, vLLM)
AI_BASE_URL=http://192.168.100.62:8002/v1     # or http://host.docker.internal:8002/v1
AI_MODEL=gpt-oss:20b
AI_API_KEY=none
AI_MAX_RETRIES=4

# Embeddings — bge-m3 via Ollama native API (optional; empty disables vector search)
AI_EMBEDDING_URL=http://192.168.100.62:11434  # Ollama, native /api/embed (no /v1)
AI_EMBEDDING_MODEL=bge-m3
AI_EMBEDDING_API=ollama                        # ollama | openai
EMBEDDING_DIM=1024

# Vision — Qwen3-VL 8b (OpenAI-compatible) — reserved, not wired yet
# AI_VISION_URL=http://192.168.100.62:8003/v1
# AI_VISION_MODEL=Qwen3-VL-8b

# Voice STT (Whisper model size: tiny | base | small | medium | large)
WHISPER_MODEL=base
# Voice TTS (edge-tts voice names)
TTS_VOICE_EN=en-US-JennyNeural
TTS_VOICE_AR=ar-SA-HamedNeural
